<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Cloud backup to the user's Google account, and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="coinflow-data.json" />
        <include domain="file" path="snapshots/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
