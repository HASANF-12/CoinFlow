<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/coinflow_brand</item>
        <item name="colorPrimaryDark">@color/coinflow_bg</item>
        <item name="colorAccent">@color/coinflow_brand</item>
        <item name="android:windowBackground">@color/coinflow_bg</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Matches the web app background so there is no white flash while the WebView loads. -->
        <item name="android:windowBackground">@color/coinflow_bg</item>
    </style>

    <!-- Android 12+ shows the icon on this colour; older versions show @drawable/splash. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/coinflow_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
